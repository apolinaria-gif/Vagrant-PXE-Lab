
---
- name: Configure Ubuntu PXE server
  hosts: all
  become: true
  gather_facts: true

  vars:
    pxe_interface: eth1
    pxe_server_ip: "10.0.0.20"
    dhcp_start: "10.0.0.100"
    dhcp_end: "10.0.0.120"

    ubuntu_version: "24.04.5"
    iso_name: "ubuntu-24.04.5-live-server-amd64.iso"
    netboot_archive: "ubuntu-24.04.5-netboot-amd64.tar.gz"

    iso_url: "https://releases.ubuntu.com/24.04.5/ubuntu-24.04.5-live-server-amd64.iso"
    netboot_url: "https://releases.ubuntu.com/24.04.5/ubuntu-24.04.5-netboot-amd64.tar.gz"

    # ОБЯЗАТЕЛЬНО замени значение на настоящий SHA-512 password hash.
    # Сгенерировать: mkpasswd --method=SHA-512
    autoinstall_password_hash: "$6$Bh4A165/hIlmmLNb$ee8XajHOJUrlFJ7yU2MX27xl0TQU5RuxlIzRpGRlcFpVMen9s3EILCK6SkVlx9qwuFMf3xAHLdiIFMzp6rEM6."

  tasks:
    - name: Update apt cache
      ansible.builtin.apt:
        update_cache: true
        cache_valid_time: 3600

    - name: Install PXE server packages
      ansible.builtin.apt:
        name:
          - dnsmasq
          - apache2
          - wget
          - curl
          - tar
        state: present

    - name: Create PXE directories
      ansible.builtin.file:
        path: "{{ item }}"
        state: directory
        mode: "0755"
      loop:
        - /srv/tftp
        - /srv/tftp/amd64
        - /srv/images
        - /srv/ks
        - /etc/dnsmasq.d

    - name: Download Ubuntu netboot archive
      ansible.builtin.get_url:
        url: "{{ netboot_url }}"
        dest: "/tmp/{{ netboot_archive }}"
        mode: "0644"
        force: false

    - name: Extract Ubuntu netboot files
      ansible.builtin.unarchive:
        src: "/tmp/{{ netboot_archive }}"
        dest: /srv/tftp
        remote_src: true
        creates: /srv/tftp/amd64/linux

    - name: Download Ubuntu Server ISO
      ansible.builtin.get_url:
        url: "{{ iso_url }}"
        dest: "/srv/images/{{ iso_name }}"
        mode: "0644"
        force: false
        timeout: 600

    - name: Configure dnsmasq
      ansible.builtin.copy:
        dest: /etc/dnsmasq.d/pxe.conf
        owner: root
        group: root
        mode: "0644"
        content: |
          port=0

          interface={{ pxe_interface }}
          listen-address={{ pxe_server_ip }}
          bind-interfaces

          dhcp-range={{ dhcp_start }},{{ dhcp_end }},255.255.255.0,12h

          dhcp-boot=amd64/pxelinux.0

          dhcp-match=set:efi-x86_64,option:client-arch,7
          dhcp-boot=tag:efi-x86_64,amd64/bootx64.efi

          enable-tftp
          tftp-root=/srv/tftp
      notify: Restart dnsmasq

    - name: Configure PXELINUX
      ansible.builtin.copy:
        dest: /srv/tftp/amd64/pxelinux.cfg/default
        owner: root
        group: root
        mode: "0644"
        content: |
          DEFAULT install
          LABEL install
            KERNEL linux
            INITRD initrd
            APPEND root=/dev/ram0 ramdisk_size=1500000 ip=dhcp url=http://{{ pxe_server_ip }}/images/{{ iso_name }} cloud-config-url=/dev/null autoinstall ds=nocloud-net;s=http://{{ pxe_server_ip }}/ks/ ---
      notify: Restart dnsmasq

    - name: Configure GRUB for UEFI
      ansible.builtin.copy:
        dest: /srv/tftp/amd64/grub/grub.cfg
        owner: root
        group: root
        mode: "0644"
        content: |
          set default=0
          set timeout=5

          menuentry "Ubuntu Server 24.04.5 Autoinstall" {
              linux /amd64/linux root=/dev/ram0 ramdisk_size=1500000 ip=dhcp url=http://{{ pxe_server_ip }}/images/{{ iso_name }} cloud-config-url=/dev/null autoinstall ds=nocloud-net\;s=http://{{ pxe_server_ip }}/ks/ ---
              initrd /amd64/initrd
          }

    - name: Create autoinstall user-data
      ansible.builtin.copy:
        dest: /srv/ks/user-data
        owner: root
        group: root
        mode: "0644"
        content: |
          #cloud-config
          autoinstall:
            version: 1
            apt:
              disable_components: []
              geoip: true
              preserve_sources_list: false
              primary:
                - arches:
                    - amd64
                    - i386
                  uri: http://us.archive.ubuntu.com/ubuntu
                - arches:
                    - default
                  uri: http://ports.ubuntu.com/ubuntu-ports
            drivers:
              install: false
            identity:
              hostname: linux
              realname: otus
              username: otus
              password: "{{ autoinstall_password_hash }}"
            kernel:
              package: linux-generic
            keyboard:
              layout: us
              variant: ""
            locale: en_US.UTF-8
            ssh:
              install-server: true
              allow-pw: true
              authorized-keys: []
            updates: security

    - name: Create NoCloud meta-data
      ansible.builtin.copy:
        dest: /srv/ks/meta-data
        owner: root
        group: root
        mode: "0644"
        content: ""

    - name: Configure Apache PXE site
      ansible.builtin.copy:
        dest: /etc/apache2/sites-available/pxe.conf
        owner: root
        group: root
        mode: "0644"
        content: |
          <VirtualHost *:80>
              ServerName {{ pxe_server_ip }}

              Alias /images/ /srv/images/
              Alias /ks/ /srv/ks/

              <Directory /srv/images>
                  Options Indexes
                  AllowOverride None
                  Require all granted
              </Directory>

              <Directory /srv/ks>
                  Options Indexes
                  AllowOverride None
                  Require all granted
              </Directory>
          </VirtualHost>
      notify: Restart apache

    - name: Enable Apache PXE site
      ansible.builtin.command:
        cmd: a2ensite pxe.conf
        creates: /etc/apache2/sites-enabled/pxe.conf
      notify: Restart apache

    - name: Disable default Apache site
      ansible.builtin.command:
        cmd: a2dissite 000-default.conf
        removes: /etc/apache2/sites-enabled/000-default.conf
      notify: Restart apache

    - name: Enable Apache service
      ansible.builtin.service:
        name: apache2
        enabled: true
        state: started

    - name: Enable dnsmasq service
      ansible.builtin.service:
        name: dnsmasq
        enabled: true
        state: started

    - name: Check Apache configuration
      ansible.builtin.command:
        cmd: apache2ctl configtest
      changed_when: false

  handlers:
    - name: Restart dnsmasq
      ansible.builtin.service:
        name: dnsmasq
        state: restarted

    - name: Restart apache
      ansible.builtin.service:
        name: apache2
        state: restarted
